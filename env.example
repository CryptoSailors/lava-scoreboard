# ── Node / chain ──────────────────────────────────────────────────────────────
# Path to the lavad binary. Adjust to your own layout.
LAVAD_BIN=/usr/local/bin/lavad
CHAIN_ID=lava-mainnet-1

# RPC of a Lava node you control.
# NOTE: 26657 is the CometBFT default and is what Axelar uses. Lava mainnet in
# our setup listens on 37657. Getting this wrong fails silently: the collector
# keeps running and the dashboard keeps serving, but no new data arrives.
LAVA_RPC=tcp://127.0.0.1:37657

DB_PATH=./data/lava.sqlite
PORT=8080
COLLECT_INTERVAL_SEC=600
VALIDATORS_LIMIT=2000

# ── Polli mode (optional; leave empty to disable) ─────────────────────────────
POLLI_BASE_URL=https://app.polli.co
# Wallet whose validator list is fetched. Leave empty unless you know which
# wallet you want to mirror.
POLLI_WALLET=
POLLI_CHAIN=LAVA
# Optional: override last review timestamp (ms since epoch) to compute next ETA
POLLI_LAST_REVIEW_TS=

# ── Delegation snapshots ──────────────────────────────────────────────────────
LAST_DELEGATION_SNAPSHOT_DATE=2026-01-09
DELEGATION_CYCLE_DAYS=21
SNAPSHOT_DAYS_BEFORE=20

# Block time in seconds, used to derive the expected block count of a period.
# Must be a valid number: a non-numeric value makes the derived uptime NaN and
# every validator scores 0 while the logs still look healthy.
BLOCK_TIME_SEC=6

# ── Archive node for governance (optional) ────────────────────────────────────
# Used for historical votes/proposals. Falls back to LAVA_RPC when empty.
# Provide your own endpoint; do not point this at someone else's node.
ARCHIVE_NODE=
